FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl sudo kmod openssl python3 python3-pip \
      tcpdump iproute2 iputils-ping ethtool tmux libnuma1 \
      ibverbs-providers mstflint \
 && rm -rf /var/lib/apt/lists/*

RUN set -e; \
    arch=$(dpkg --print-architecture); \
    case "$arch" in amd64) mdir=x86_64 ;; arm64) mdir=aarch64 ;; *) mdir="" ;; esac; \
    if [ -n "$mdir" ]; then \
      U="https://linux.mellanox.com/public/repo/mlnx_ofed/latest/ubuntu24.04/${mdir}/"; \
      PKG=$(curl -fsSL "$U" 2>/dev/null | grep -o "mft_[^\"]*_${arch}\.deb" | head -1); \
      if [ -n "$PKG" ]; then \
        curl -fsSL "${U}${PKG}" -o /tmp/mft.deb \
        && apt-get update \
        && apt-get install -y --no-install-recommends /tmp/mft.deb \
        && rm -rf /tmp/mft.deb /var/lib/apt/lists/*; \
      fi; \
    fi

COPY bundle/debs/ /tmp/debs/
RUN apt-get update \
 && apt-get install -y --no-install-recommends /tmp/debs/*.deb \
 && rm -rf /tmp/debs /var/lib/apt/lists/*

RUN pip3 install --break-system-packages vpp-papi scapy

COPY bundle/fastacl-license.json bundle/fastacl-license.json.sig /opt/fastacl/

WORKDIR /src
