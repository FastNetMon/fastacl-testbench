# Platform ceiling (run.sh epyc-platform platform): epyc-sp5 with two
# ConnectX-8 and the BlueField-3 in NIC mode, every port ingress, fed by six
# server1 ports.  The stages add generator cards one group at a time.
DUT=epyc-platform
GEN=server1
CALIBRATE=1
DUT_KIND=host
