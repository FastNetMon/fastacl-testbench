# Socket-direct ConnectX-8, packet rate of one port (run.sh epyc-sd-pps
# platform): both server1 ConnectX-7 through the MikroTik into ConnectX-8
# port 1, 64 B.  TRex runs only the two ConnectX-7 so they share one port
# pair's cores (46: TRex allows 48 TX queues per port); VPP gives port 1's
# two functions all 62 workers.  Stages are name:gen-ports[:frame[:rate]].
DUT=epyc-sd
GEN=server1
CALIBRATE=1
DUT_KIND=host
TREX_PCI_LIST="0000:81:00.0 0000:c2:00.1"
TREX_CORES=46
SINK_PORTS="0000:01:00.1:sd-p1a:31:enp1s0f1np1 0000:02:00.1:sd-p1b:31:enp2s0f1np1"
SINK_PHYS="1 1"
SINK_SPLIT=""
PLATFORM_STAGES="${PLATFORM_STAGES:-cx7-1:0 cx7-2:1 p1-r100:0,1:64:100mpps p1-r140:0,1:64:140mpps p1-64:0,1}"
PLATFORM_TOPOLOGY="${PLATFORM_TOPOLOGY:-server1 (TRex, two ports): ConnectX-7 #1 and #2 at 200G through a MikroTik switch into ConnectX-8 port 1 (400G optics); the ConnectX-8 runs socket direct, ConnectX-7 #1 feeds port 1's function on the first PCIe Gen5 x16 link and #2 the one on the second; every DUT port is an ingress and drops everything}"
